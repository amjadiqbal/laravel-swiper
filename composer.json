{
    "name": "amjadiqbal/laravel-swiper",
    "description": "Swiper sliders and carousels for Laravel: Blade components with typed props for navigation, pagination, thumbs, autoplay and lazy loading; Livewire-safe (survives updates and wire:navigate); slides from Eloquent models, Spatie Media Library or a storage disk folder, with responsive images and accessible defaults.",
    "keywords": [
        "laravel",
        "laravel-package",
        "swiper",
        "swiperjs",
        "slider",
        "carousel",
        "image-slider",
        "image-gallery",
        "thumbnail-gallery",
        "blade",
        "blade-components",
        "livewire",
        "wire-navigate",
        "responsive-images",
        "accessibility"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://amjad.com.pk/laravel/packages/laravel-swiper",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/laravel-swiper/issues",
        "source": "https://github.com/amjadiqbal/laravel-swiper",
        "docs": "https://amjad.com.pk/laravel/packages/laravel-swiper"
    },
    "require": {
        "php": "^8.3",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "livewire/livewire": "Carousels re-initialise after Livewire updates and wire:navigate (Livewire 3 or 4).",
        "spatie/laravel-medialibrary": "Pass Media items straight to :images and get their responsive srcset."
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\LaravelSwiper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\LaravelSwiper\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\LaravelSwiper\\LaravelSwiperServiceProvider"
            ],
            "aliases": {
                "Swiper": "AmjadIqbal\\LaravelSwiper\\Facades\\Swiper"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
